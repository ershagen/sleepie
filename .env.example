# Database (Supabase Postgres pooler)
DATABASE_URI=postgresql://postgres.xxxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Payload
PAYLOAD_SECRET=generate-a-long-random-string
NEXT_PUBLIC_SERVER_URL=https://your-domain.vercel.app

# Vercel Blob (auto-set when Blob store is connected to the project)
BLOB_READ_WRITE_TOKEN=

# Mollie (payments)
MOLLIE_API_KEY=

# Dropshipping (optional)
CJ_API_KEY=
